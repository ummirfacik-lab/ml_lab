y_pred = model.predict(x_test)
print("Accuracy:", accuracy_score(y_test, y_pred))
print("Precision:", precision_score(y_test, y_pred, pos_label="positive"))
print("Recall :", recall_score(y_test, y_pred, pos_label="positive"))
